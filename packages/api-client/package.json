{
  "name": "@task-management/api-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../services/task-api/openapi/http-api.yaml -o src/generated/task-api.ts && openapi-typescript ../../services/notifications/openapi/http-api.yaml -o src/generated/notifications.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.5"
  }
}
