# Local demo configuration. Copy is created by `docker compose --profile tools run --rm setup`,
# which replaces every __GENERATE__ value with a fresh random secret in the ignored `.env`.
# Never commit `.env`. All values here are placeholders, not usable credentials.

# ---- Edge and loopback-only admin bindings -------------------------------------------
EDGE_HTTP_PORT=8080
STUDIO_PORT=54323
EMAIL_CAPTURE_UI_PORT=54324
SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8080/auth/v1
SUPABASE_PUBLIC_URL=http://localhost:8080

# ---- Directory defaults --------------------------------------------------------------
# IANA zone for accounts that have not chosen one (must exist in pg_timezone_names).
DEFAULT_TIME_ZONE=Europe/Berlin

# ---- Supabase PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=__GENERATE__

# ---- Supabase Auth / API keys ---------------------------------------------------------
# Legacy HS256 secret: used only inside the Supabase stack, never given to Spring services.
JWT_SECRET=__GENERATE__
JWT_EXPIRY=3600
ANON_KEY=__GENERATE__
SERVICE_ROLE_KEY=__GENERATE__
# ES256 signing keys (Auth signs user tokens with the EC key; services verify via JWKS).
JWT_KEYS=__GENERATE__
JWT_JWKS=__GENERATE__
ANON_KEY_ASYMMETRIC=__GENERATE__
SERVICE_ROLE_KEY_ASYMMETRIC=__GENERATE__
# Opaque keys. The publishable key is public (browser); the secret key is server-only.
SUPABASE_PUBLISHABLE_KEY=__GENERATE__
SUPABASE_SECRET_KEY=__GENERATE__
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# ---- Supabase internals ---------------------------------------------------------------
SECRET_KEY_BASE=__GENERATE__
REALTIME_DB_ENC_KEY=__GENERATE__
PG_META_CRYPTO_KEY=__GENERATE__
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=__GENERATE__
STORAGE_TENANT_ID=stub
REGION=local
GLOBAL_S3_BUCKET=stub
ATTACHMENT_BUCKET=task-attachments

# ---- Database roles (created by db-bootstrap) -----------------------------------------
IDENTITY_OWNER_PASSWORD=__GENERATE__
TASK_OWNER_PASSWORD=__GENERATE__
TASK_APP_PASSWORD=__GENERATE__
NOTIFICATION_OWNER_PASSWORD=__GENERATE__
NOTIFICATION_APP_PASSWORD=__GENERATE__

# ---- Internal service credentials (distinct per caller) -------------------------------
NOTIFICATIONS_TO_TASK_API_TOKEN=__GENERATE__
OPERATOR_TOKEN=__GENERATE__

# ---- Optional email capture (profile email-capture) -----------------------------------
SMTP_HOST=email-capture
SMTP_PORT=1025
SMTP_SENDER=tasks@demo.invalid
